{
    "name": "arzcode/filament-magic-login",
    "description": "Passwordless \"email me a login link\" option for Filament panels, alongside the standard password form.",
    "keywords": [
        "laravel",
        "filament",
        "magic-link",
        "passwordless",
        "login",
        "authentication"
    ],
    "homepage": "https://github.com/arzcode/filament-magic-login",
    "license": "MIT",
    "authors": [
        {
            "name": "Arzcode",
            "email": "hola@arzcode.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Arzcode\\FilamentMagicLogin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arzcode\\FilamentMagicLogin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:database",
            "@test:cache"
        ],
        "test:database": "MAGIC_LOGIN_STORAGE=database vendor/bin/pest",
        "test:cache": "MAGIC_LOGIN_STORAGE=cache vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Arzcode\\FilamentMagicLogin\\FilamentMagicLoginServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
